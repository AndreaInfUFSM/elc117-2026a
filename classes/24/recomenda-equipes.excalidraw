    {
      "id": "context-text",
      "type": "text",
      "x": 110,
      "y": 155,
      "width": 563.2833251953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 12347,
      "version": 180,
      "versionNonce": 2145783435,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1779725763598,
      "link": null,
      "locked": false,
      "text": "Contexto:\n- um grande grupo / turma de pessoas\n- essas pessoas têm vários atributos\n- equipes precisam ser formadas com diferentes critérios\n- turma reutilizada em várias formações\n\n",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 153,
      "containerId": null,
      "originalText": "Contexto:\n- um grande grupo / turma de pessoas\n- essas pessoas têm vários atributos\n- equipes precisam ser formadas com diferentes critérios\n- turma reutilizada em várias formações\n\n",
      "lineHeight": 1.25,
      "index": "a2",
      "autoResize": true
    },
    {
      "id": "system-text",
      "type": "text",
      "x": 110,
      "y": 345,
      "width": 510,
      "height": 190,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
