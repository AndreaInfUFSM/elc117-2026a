      "boundElements": [
        {
          "id": "3QgknO36UNipV4DRtIJCE",
          "type": "arrow"
        }
      ],
      "updated": 1779725956837,
      "link": null,
      "locked": false,
      "text": "O sistema deve considerar:\n- gerenciamento da turma / grupo\n- tamanho desejado das equipes\n  ou número de equipes\n- múltiplas estratégias de recomendação\n- equipes geradas\n- ajustar / gerar novamente",
      "fontSize": 20,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 178,
      "containerId": null,
      "originalText": "O sistema deve considerar:\n- gerenciamento da turma / grupo\n- tamanho desejado das equipes\n  ou número de equipes\n- múltiplas estratégias de recomendação\n- equipes geradas\n- ajustar / gerar novamente",
      "lineHeight": 1.25,
      "index": "a3",
      "autoResize": true
    },
